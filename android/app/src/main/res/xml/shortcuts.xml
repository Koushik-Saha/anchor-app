<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the launcher icon → "Start reset" → anchor://start → straight into classic-90. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="start_reset"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_start_short"
        android:shortcutLongLabel="@string/shortcut_start_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="anchor://start"
            android:targetPackage="app.anchor.reset"
            android:targetClass="app.anchor.reset.MainActivity" />
    </shortcut>
</shortcuts>
