# Copy to android/keystore.properties (gitignored — never commit the real one).
# The keystore lives OUTSIDE the repo. Create it once with:
#   keytool -genkeypair -v -keystore ~/keys/anchor-upload.jks -alias anchor-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=~/keys/anchor-upload.jks
storePassword=CHANGE_ME
keyAlias=anchor-upload
keyPassword=CHANGE_ME
